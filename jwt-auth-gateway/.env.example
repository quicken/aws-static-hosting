# Copy to .env (git-ignored). build.mjs and deploy.sh both read it.

# --- Cognito (outputs of cloudformation/cognito.yaml, or your own user pool) ---
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
# Public app client (no secret) with the authorisation code grant enabled.
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Hosted UI / managed login host, without https://
COGNITO_DOMAIN=my-prefix.auth.ap-southeast-2.amazoncognito.com

# --- Session stamp (see src/lib/session.ts) ---
# Signs the cookie the CloudFront Function gate checks on every request. Keep it secret and
# stable across deploys. Generate once with: openssl rand -base64 32
SESSION_KEY=
# To rotate: move the current key here, set a new SESSION_KEY, deploy. Clear this on a later deploy.
SESSION_KEY_PREVIOUS=

# --- Routing (baked into the gate) ---
# Folder whose subfolders are the individual SPAs (e.g. /app/customers, /app/billing). The
# authenticated shell lives under this prefix; anything outside it (the bucket root) is left
# untouched by the gate's shell routing, so / stays free for a public landing page or health
# check. Must match the Trailhead shell's own appBasePath. Set empty to serve off the root instead.
APP_BASE_PATH=/app
# Comma-separated prefixes served without a login.
PUBLIC_PATHS=/public
# Same-origin API prefix (one path segment). Only used when API_ORIGIN_DOMAIN is set below.
API_PREFIX=/api

# --- Deployment. Lambda@Edge lives in us-east-1, so the stack does too. ---
# provision.sh deploys the stack once; deploy-code.sh rolls out function code with no stack update.
STACK_NAME=static-hosting
# Optional named AWS profile for every aws call in both scripts. Leave unset/commented to use
# the default profile.
# AWS_PROFILE=default

# Optional custom domain. The certificate must be in ACM in us-east-1.
DOMAIN_NAME=
CERTIFICATE_ARN=

# Optional API origin behind /api/*, e.g. abc123.execute-api.ap-southeast-2.amazonaws.com
API_ORIGIN_DOMAIN=
