{
  "name": "jwt-auth-gateway",
  "version": "2.0.0",
  "description": "Lambda@Edge gateway that puts a Cognito login (PKCE, HttpOnly cookies) and per-app SPA routing in front of static apps hosted on S3 + CloudFront.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "provision": "./_dev/scripts/provision.sh",
    "deploy-code": "./_dev/scripts/deploy-code.sh"
  },
  "author": "Marcel Scherzer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quicken/aws-static-hosting.git",
    "directory": "jwt-auth-gateway"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
